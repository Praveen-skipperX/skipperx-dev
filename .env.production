# Production Environment Variables for Vercel
# Add these in Vercel Dashboard > Project Settings > Environment Variables

# Backend API URL (your backend deployment URL)
REACT_APP_API_URL=https://your-backend-url.com/api
REACT_APP_GOOGLE_AUTH_URL=https://your-backend-url.com/api/auth/google

# Note: Replace 'your-backend-url.com' with your actual backend URL
# If backend is on same domain: https://skipperx.io/api
